# Copie este arquivo para .env e ajuste conforme necessário.
# Caminhos relativos são resolvidos a partir da raiz do projeto.
# Nunca coloque segredos neste arquivo de exemplo.

JARVIS_APP_NAME=JARVIS
# dev | prod
JARVIS_ENVIRONMENT=dev

# DEBUG | INFO | WARNING | ERROR | CRITICAL
JARVIS_LOG_LEVEL=INFO
JARVIS_LOG_DIR=logs
JARVIS_LOG_MAX_BYTES=5242880
JARVIS_LOG_BACKUP_COUNT=5

JARVIS_DATA_DIR=data
JARVIS_DATABASE_PATH=data/jarvis.db
